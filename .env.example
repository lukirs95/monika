# Konfiguration von Monika (docs/ARCHITECTURE.md, Abschnitt 14; docs/contracts/bootstrap.md).
# Kopieren nach .env (bzw. deploy/.env für den Stack), ausfüllen, Rechte 600. Unbekannte
# MONIKA_*-Variablen und ungültige Werte brechen den Start ab. Dauern im Go-Format, dazu d für Tage.

# --- Pflicht ------------------------------------------------------------------

# Schlüssel des Secret-Stores, 32 Byte Base64: openssl rand -base64 32
# Getrennt vom Backup sichern; ohne ihn sind Secrets und TOTP nicht lesbar.
MONIKA_MASTER_KEY=
# Nur während einer Rotation: der alte Schlüssel (docs/OPERATIONS.md).
#MONIKA_MASTER_KEY_PREVIOUS=

# PostgreSQL. Im Stack (deploy/compose.prod.yaml) setzt der Stack die Verbindung selbst.
MONIKA_DATABASE_URL=postgres://monika:monika@127.0.0.1:5432/monika?sslmode=disable

# Öffentliche Adresse: Origin-Prüfung, Secure-Cookie bei https, Links in Weiterleitungen.
MONIKA_PUBLIC_URL=https://monika.example

# --- Optional, mit Standardwerten ----------------------------------------------

#MONIKA_LISTEN=:8080
# Netze (CIDR, durch Komma getrennt), deren X-Forwarded-For gilt; im Stack gesetzt.
#MONIKA_TRUSTED_PROXIES=
#MONIKA_SESSION_IDLE=12h
#MONIKA_SESSION_MAX=168h
# Gleichzeitige Abfragen aller Treiber.
#MONIKA_SCHEDULER_CONCURRENCY=32
# debug, info, warn, error; json oder text (Entwicklung).
#MONIKA_LOG_LEVEL=info
#MONIKA_LOG_FORMAT=json

# InfluxDB für Zeitreihen; ohne URL schreibt Monika keine. Im Stack setzt der Stack URL, Org und
# Bucket; das Token gilt dort auch für die Einrichtung von InfluxDB.
#MONIKA_INFLUX_URL=
MONIKA_INFLUX_TOKEN=
#MONIKA_INFLUX_ORG=
#MONIKA_INFLUX_BUCKET=
#MONIKA_INFLUX_INTERVAL=1s

# Aufbewahrung des Verlaufs; 0 = nie löschen.
#MONIKA_RETENTION_FINDINGS=180d
#MONIKA_RETENTION_RUNS=180d
#MONIKA_RETENTION_AUDIT=730d

# Initialer Admin, nur angelegt, wenn es noch keinen Benutzer gibt; danach entfernen.
# Passwort mindestens 12 Zeichen; TOTP richtet er bei der ersten Anmeldung ein.
#MONIKA_ADMIN_USER=admin
#MONIKA_ADMIN_PASSWORD=

# Pfad dieser Datei, wenn sie nicht ./.env heißt (nur als Umgebungsvariable sinnvoll).
#MONIKA_ENV_FILE=

# --- Nur für den Stack (deploy/compose.prod.yaml) ---------------------------------

# Domain für Caddy (TLS per Let's Encrypt); MONIKA_PUBLIC_URL ist dann https://<domain>.
STACK_DOMAIN=monika.example
STACK_POSTGRES_PASSWORD=
# mindestens 8 Zeichen (Vorgabe von InfluxDB)
STACK_INFLUX_PASSWORD=
# Image von Monika, z. B. aus make image.
#STACK_IMAGE=monika:latest
